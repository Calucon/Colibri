TCP_HOST='0.0.0.0'
TCP_PORT=9012

VOICE_HOST='0.0.0.0'
VOICE_PORT=9013
VOICE_SAMPLING_RATE=48000
VOICE_RECORDING=false

# Mirrors broadcast/sync traffic between clients into the admin log page (debug level).
# On by default; set to false to silence it if a high-frequency sync channel floods the
# log page's ring buffer.
LOG_BROADCAST_TRAFFIC=true

WEBSERVER_HOST='0.0.0.0'
WEBSERVER_PORT=9011
WEBSERVER_ROOT='../ui/'
BASE_URL=''

DATA_ROOT='../../data'

# Frames walked when capturing a stack trace for a logged error.
STACK_TRACE_LIMIT=30
