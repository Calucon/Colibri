TCP_HOST='0.0.0.0'
TCP_PORT=9012

VOICE_HOST='0.0.0.0'
VOICE_PORT=9013
VOICE_SAMPLING_RATE=48000
VOICE_RECORDING=false

WEBSERVER_HOST='0.0.0.0'
WEBSERVER_PORT=9011
WEBSERVER_ROOT='../ui/'
BASE_URL=''

DATA_ROOT='../../data'

# Frames walked when capturing a stack trace for a logged error.
STACK_TRACE_LIMIT=30

# Least severe level printed to stdout/stderr (error, warn, info or debug). The admin UI's log
# keeps every level regardless. Broadcast traffic stays off the console unless switched on here.
CONSOLE_LOG_LEVEL=info
CONSOLE_LOG_BROADCAST_TRAFFIC=false

# How many messages from Unity (TCP) clients may be waiting for the server's main thread before it
# drops incoming model::update and broadcast::* messages (never handshakes, heartbeats,
# model::request, model::delete or log lines). Keeps an overloaded server's memory and latency
# bounded instead of queuing without limit; each overload episode is logged as a warning.
# 0 never drops.
TCP_INBOUND_BACKLOG_LIMIT=2000

# How many model::update and broadcast::* messages a second a single client (Unity or web) may
# send before the rest are dropped, and how many it may send at once after a quieter stretch. Far
# above legitimate traffic (10 objects at 72 Hz is 720 a second): it catches a runaway send loop
# before it slows the server down for everyone. Logged as a warning naming the client. 0: no limit.
CLIENT_MESSAGE_RATE_LIMIT=1000
CLIENT_MESSAGE_RATE_BURST=2000

# Log a warning when one app has more clients than this (Unity and web together, admin UI not
# counted). The server's work grows with the square of an app's size, so a class whose groups all
# kept the same app name can overload it; the warning names the app. 0: never warn.
APP_CLIENT_WARNING_THRESHOLD=8
