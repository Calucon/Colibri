{
  "name": "colibri-server",
  "version": "2.0.0",
  "type": "module",
  "main": "dist/server/main.js",
  "author": "HCI Group, University of Konstanz",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint \"**/*.{js,ts}\"",
    "build": "npm run gui:build && npm run server:build",
    "start": "npm run server:start",
    "watch": "concurrently -k -p \"[{name}]\" -n \"Angular,Server-Compile,Server-Node\" -c \"green.bold,blue.bold,yellow.bold\" \"npm run gui:watch\" \"npm run server:watch:ts\" \"npm run server:watch:node\"",
    "publish": "node publish.mjs",
    "gui:build": "ng build --configuration production",
    "gui:watch": "ng serve",
    "server:start": "node --enable-source-maps dist/server/main.js",
    "server:build": "tsc --p src/server",
    "server:watch:ts": "tsc --p src/server -w",
    "server:watch:node": "nodemon --watch dist/server/* --exec \"npm run server:start\"",
    "test:tcpclient": "tsx test/tcp-client-test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "gui:test": "ng test --watch=false",
    "bench": "vitest bench"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.19",
    "@angular/cdk": "^21.2.9",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "@angular/platform-browser-dynamic": "21.2.19",
    "@angular/router": "21.2.19",
    "@fontsource/fira-mono": "^5.2.5",
    "@fontsource/roboto": "^5.2.5",
    "@primeng/themes": "^21.0.4",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.6",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "wavefile": "^11.0.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.19",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@angular/language-service": "21.2.19",
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@typescript-eslint/utils": "^8.59.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
